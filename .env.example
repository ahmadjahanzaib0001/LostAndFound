# Copy this file to ".env" and fill in your values. Never commit .env.

PORT=5000
SITE_URL=http://localhost:5000
NODE_ENV=development

# MongoDB Atlas connection string - include the database name at the end (/lostfound)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lostfound?retryWrites=true&w=majority

# Any long random string (32+ chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Cloudinary (item and avatar photos) - from the Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (sends the 6-digit verification code). Gmail: use a 16-character App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Campus Lost & Found <your-address@gmail.com>"

# Only these email domains can register (comma separated). Leave empty to allow any email.
# Example: ALLOWED_EMAIL_DOMAINS=uet.edu.pk
ALLOWED_EMAIL_DOMAINS=

# Shown to people whose claim is approved (landing page, claims page and approval email)
COLLECTION_POINT=Campus Security Office
COLLECTION_HOURS=Mon-Fri, 9:00 AM - 4:00 PM

# The email that becomes the protected core admin once it registers on the site
CORE_ADMIN_EMAIL=
